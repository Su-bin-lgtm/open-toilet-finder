# ==========================================
# Open Toilet Finder - .gitignore
# ==========================================

# 1. 보안 및 환경 변수 파일 (API 키, DB 접속 비밀번호 보호)
.env
.env.local
.env.*.local
*.local.yml
application-local.yml
application-secret.yml

# 2. 운영체제 및 IDE 설정 파일
.DS_Store
Thumbs.db
*.swp
*.bak
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# 3. Java / Gradle / Maven 빌드 산출물
target/
build/
.gradle/
*.class
*.jar
*.war
out/

# 4. Node.js / React Native / Expo 산출물
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.expo/
dist/
web-build/
*.tsbuildinfo

# 5. 데이터 파일 중 대용량/개인 식별 데이터
data/raw/*.zip
data/raw/*.tar.gz
data/processed/*.dump

