# [로컬 개발 환경용 템플릿]
# 이 파일을 복사하여 'application-local.yml'로 저장한 후, 본인의 MySQL 계정 정보를 입력하세요.
# 주의: 'application-local.yml' 파일은 .gitignore에 등록되어 있으므로 Git에 올라가지 않습니다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/open_toilet?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
    username: root
    password: YOUR_LOCAL_PASSWORD

